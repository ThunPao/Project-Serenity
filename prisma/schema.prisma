model ShopItems {
  id          Int            @id @default(autoincrement())
  title       String
  description String?
  imageUrl    String
  itemCommand ItemCommands[]
  checkOnline Boolean        @default(false)
  price       Int            @default(0)
  saleCount   Int            @default(0)
  startDate   DateTime?
  expireDate  DateTime?
  createdAt   DateTime       @default(now())
  catty       ShopCategories @relation(fields: [catId], references: [id], onDelete: Cascade)
  catId       Int
  isActive    Boolean        @default(false)
}

model ItemCommands {
  id          Int        @id @default(autoincrement())
  itemCommand String?    @db.Text
  ShopItems   ShopItems? @relation(fields: [shopItemsId], references: [id])
  shopItemsId Int?
}

model ShopCategories {
  id       Int         @id @default(autoincrement())
  title    String
  isActive Boolean     @default(true)
  shopItem ShopItems[]
}

model ShopHistory {
  id        Int      @id @default(autoincrement())
  title     String
  points    Int
  email     String?
  createdAt DateTime @default(now())
  // UserInfo  UserInfo @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  User      User     @relation(fields: [userId], references: [id])
}

model TopupRating {
  id       Int     @id @default(autoincrement())
  price    Int
  points   Int
  isActive Boolean @default(true)
}

model TopupHistory {
  id          Int      @id @default(autoincrement())
  topupAmount Int
  createdAt   DateTime @default(now())
  userId      String
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RedeemCoupons {
  id            Int             @id @default(autoincrement())
  title         String
  redeemCode    String          @unique
  rewardPoint   Int?
  rewardCommand String?
  redeemCount   Int             @default(0)
  useLimits     Int?
  startDate     DateTime?
  expireDate    DateTime?
  isActive      Boolean         @default(false)
  RedeemHistory RedeemHistory[]
}

model RedeemHistory {
  id        Int           @id @default(autoincrement())
  couponId  Int
  Coupon    RedeemCoupons @relation(fields: [couponId], references: [id])
  createdAt DateTime      @default(now())
  // UserInfo  UserInfo      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  User      User          @relation(fields: [userId], references: [id])
}
