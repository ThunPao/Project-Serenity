# Database connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# Auth.js / Discord OAuth
DISCORD_ID="your_discord_client_id"
DISCORD_SECRET="your_discord_client_secret"
AUTH_SECRET="your_auth_secret_key"

# Minecraft Server Integration
SERVER_IP="127.0.0.1"
MC_QUERY_PORT="25565"
RCON_PORT="25575"
RCON_PWD="your_rcon_password"

# Rate Limiter Secret
COOKIE_SECRET="your_rate_limiter_cookie_secret"

# Redis Cache (Set to "false" to disable without removing code, or "true" to enable)
ENABLE_REDIS="false"
REDIS_URL="redis://localhost:6379"
